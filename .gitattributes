# Normalize text files to LF in the repository; check out with the platform's default.
* text=auto

# Shell scripts must keep LF, or they fail on Linux.
*.sh  text eol=lf
# Windows-only files keep CRLF.
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary files: never touch line endings, no text diffs.
*.lbd   binary
*.h5    binary
*.ico   binary
*.icns  binary
*.png   binary
*.mltbx binary
*.whl   binary
