# Machine-specific editor/agent settings (e.g. .claude/launch.json holds absolute paths)
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
languages/python/dist/
viewer/dist/

# Built web UI (generated by `npm run build` in viewer/web/)
viewer/src/lbd_viewer/static/
# Help and language modules, staged only while scripts/build_wheels.py builds the release wheel
viewer/src/lbd_viewer/docs/
viewer/src/lbd_viewer/sdk/

# Node
viewer/web/node_modules/
viewer/web/dist/

# Julia (resolved per machine; Project.toml is the source of truth)
languages/julia/Manifest.toml

# Build output (normally outside the repo, see scripts/)
build/
dist/

# Temporary files left by an interrupted .lbd save
*.lbd.tmp-*

# OS and sync-client files
Thumbs.db
desktop.ini
.DS_Store
@eaDir/
#recycle/
*.SynologyWorkingDirectory

# Personal sandbox (notebook + mock data), not part of the project
playground/

# Built documentation site (uv run mkdocs build)
site/
